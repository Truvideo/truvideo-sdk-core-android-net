<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Version>2.0.2</Version>
        <TargetFramework>net10.0-android</TargetFramework>
        <MauiVersion>10.0.10</MauiVersion>
        <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsBindingProject>true</IsBindingProject>
        <RepositoryUrl>https://github.com/Truvideo/truvideo-sdk-core-android-net</RepositoryUrl>
        <IsTrimmable>false</IsTrimmable> <!-- Avoids IL2026 ExportAttribute trimming warnings -->
        <!-- Use a Maui version that exists on nuget.org / installed workloads -->
    </PropertyGroup>

    <!-- Gradle project reference -->
    <ItemGroup>
        <NLIGradleProjectReference Include="../TruVideoCoreAndroid">
            <ModuleName>TruvideoCore</ModuleName>
        </NLIGradleProjectReference>
    </ItemGroup>

    <!-- NuGet References -->
    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Maui.NativeLibraryInterop.BuildTasks" Version="0.0.1-pre1" />
        <!-- Explicit versions (adjust if your MAUI workload uses a different version) -->
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
        <!-- KotlinX Serialization Core & JSON -->
<!--        <PackageReference Include="Xamarin.KotlinX.Serialization.Core.Jvm" Version="1.9.0.1" />-->
<!--        <PackageReference Include="Xamarin.KotlinX.Serialization.Json.Jvm" Version="1.9.0.1" />-->
    </ItemGroup>

    <!-- Android AAR/JAR references -->
    <ItemGroup Condition="$(TargetFramework.Contains('android'))">
        <!-- Core SDK -->

        <AndroidLibrary Include="../TruVideoCoreAndroid/TruvideoCore/libs/core-release1.aar" Bind="false" Visible="false" />
        <AndroidLibrary Include="../TruVideoCoreAndroid/TruvideoCore/libs/sdk-core-1.0.5.aar" Bind="false" Visible="false" />
